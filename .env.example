# Path to the base X4: Foundations game installation directory
X4_INSTALL_PATH=

# Ollama local endpoint
OLLAMA_ENDPOINT=http://localhost:11434

# Selected LLM model name in Ollama (ADR-0005 provisional default: gemma4:12b)
MODEL_NAME=gemma4:12b

# Embedding model in Ollama
EMBEDDING_MODEL=qwen3-embedding:0.6b

# Path to the local SQLite database file
DATABASE_PATH=data/db/x4_advisor.db

# Minimum vector similarity threshold for knowledge retrieval (calibrated empirically during M6)
VECTOR_RELEVANCE_THRESHOLD=
